import { Request, Response } from "express";
import expressAsyncHandler from "express-async-handler";

import { userService } from "../services";
import { UserType } from "../types/user.type";

export const registerUser = expressAsyncHandler(
  async (req: Request<never, never, UserType>, res: Response) => {
    const user = await userService.registerUser(req.body);
    res.status(200).send(user);
  }
);

export const loginUser = expressAsyncHandler(
  async (req: Request<never, never, UserType>, res: Response) => {
    const { user, accessToken, refreshToken } = await userService.loginUser(
      req.body
    );
    res.cookie("refreshToken", refreshToken, {
      httpOnly: true,
      maxAge: 1000 * 60 * 60 * 24 * 30,
    });
    res.status(200).send({ user, accessToken });
  }
);

export const refreshUserToken = expressAsyncHandler(
  async (req: Request, res: Response) => {
    const token = req.cookies.refreshToken;

    const accessToken = await userService.refreshUserToken(token);
    res.status(200).send({ accessToken });
  }
);

export const logoutUser = expressAsyncHandler(
  async (req: Request, res: Response) => {
    res.clearCookie("refreshToken");
    res.status(200).send({ message: "Logout successful" });
  }
);

export const getUserProfile = expressAsyncHandler(
  async (req: Request, res: Response) => {
    const user = await userService.getUserProfile(
      req.params?.id || req?.user?._id.toString() || ""
    );
    res.status(200).send(user);
  }
);

export const updateUser = expressAsyncHandler(
  async (req: Request<{ id: string }, never, UserType>, res: Response) => {
    const user = await userService.updateUser(
      req.params?.id || req?.user?._id.toString() || "",
      req.body,
      req.user
    );
    res.status(200).send(user);
  }
);

export const deleteUser = expressAsyncHandler(
  async (req: Request<{ id: string }>, res: Response) => {
    const user = await userService.deleteUser(req.params?.id, req.user);
    res.status(200).send(user);
  }
);

export const getSuperuser = expressAsyncHandler(
  async (req: Request, res: Response) => {
    const user = await userService.getSuperuser();
    res.status(200).send({ exists: !!user });
  }
);

export const queryUsers = expressAsyncHandler(
  async (req: Request, res: Response) => {
    const users = await userService.queryUsers(
      {},
      {
        page: req?.query?.page ? +req.query.page : 1,
        limit: req?.query?.limit ? +req.query.limit : 1,
        sort: { createdAt: -1 },
      }
    );
    res.status(200).send(users);
  }
);
