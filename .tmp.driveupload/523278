import { Loader2, Save } from "lucide-react";
import { ChangeEvent, MouseEventHandler, useRef, useState } from "react";
import { toast } from "sonner";

import useAxios from "@/hooks/useAxios";
import { Device, DeviceConfig } from "@/types/device.type";
import { refetchRequest } from "@/utils/axiosStore";
import { EC_CONFIG_3, PH_CONFIG_5 } from "@/utils/constants";

import Select from "../Select";
import { Button } from "../ui/button";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "../ui/dialog";
import { Input } from "../ui/input";
import { Label } from "../ui/label";

const DEFAULT_FORMDATA: Device<DeviceConfig> = {
  id: "",
  type: "",
};

export default function CreateDeviceModal() {
  const [formData, setFormData] =
    useState<Device<DeviceConfig>>(DEFAULT_FORMDATA);

  const triggerRef = useRef<HTMLButtonElement>(null);

  const { request: createDevice, loading: createDeviceLoading } = useAxios<
    Device<DeviceConfig>
  >({ method: "POST", url: "/api/device" });

  const handleInputChange = (
    e: ChangeEvent<HTMLInputElement | HTMLTextAreaElement>
  ) => {
    const { value, name } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
  };

  const handleSubmit: MouseEventHandler<HTMLButtonElement> = async (e) => {
    e.preventDefault();

    const { data } = await createDevice({
      body: {
        ...formData,
        deviceConfigId: formData?.type === "ec" ? EC_CONFIG_3 : PH_CONFIG_5,
      },
    });
    setFormData(DEFAULT_FORMDATA);
    toast.success("Device created");
    if (triggerRef?.current && data) triggerRef.current.click();
    if (data) {
      refetchRequest(["devices"]);
    }
  };

  return (
    <Dialog>
      <DialogTrigger ref={triggerRef} asChild>
        <Button type="button">Create</Button>
      </DialogTrigger>
      <DialogContent>
        <DialogHeader>
          <DialogTitle>Create new Device</DialogTitle>
          <DialogDescription>You can create new device here.</DialogDescription>
        </DialogHeader>

        <div>
          <div>
            <Label className="mb-1" htmlFor="id">
              Device ID
            </Label>
            <Input
              id="id"
              value={formData?.id}
              onChange={handleInputChange}
              name="id"
              required
            />
          </div>
          <div className="mt-3">
            <Label className="mb-1" htmlFor="type">
              Device Type
            </Label>
            <Select
              id="type"
              value={formData?.type}
              options={[
                { label: "EC", value: "ec" },
                { label: "PH", value: "ph" },
              ]}
              onChange={(val) =>
                setFormData((prev) => ({ ...prev, type: val }))
              }
              required
            />
          </div>
        </div>

        <DialogFooter>
          <Button type="button" onClick={handleSubmit}>
            {createDeviceLoading ? (
              <Loader2 className="animate-spin" />
            ) : (
              <Save />
            )}
            Save
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
