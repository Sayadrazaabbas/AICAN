import mongoose from "mongoose";
import mongoosePaginate from "mongoose-paginate-v2";

import models from "../constanst/model.constant";
import { IDeviceDocument } from "../types/device.type";

const DeviceSchema = new mongoose.Schema<IDeviceDocument>(
  {
    id: { type: String, required: true },
    type: { type: String, required: true },
    configuration: { type: Object },
    calibrate: { type: Boolean, default: false },
    log: { type: Boolean, default: false },
    status: { type: String },
    lastUpdated: { type: Date },
    deviceConfigId: {
      type: mongoose.Schema.Types.ObjectId,
      ref: models.deviceConfig,
    },
  },
  {
    timestamps: true,
  }
);

DeviceSchema.plugin(mongoosePaginate);

const Device = mongoose.model<
  IDeviceDocument,
  mongoose.PaginateModel<IDeviceDocument>
>(models.device, DeviceSchema);

export default Device;
