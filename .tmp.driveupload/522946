import { Request, Response } from "express";
import expressAsyncHandler from "express-async-handler";
import { Types } from "mongoose";
import { HeaderAndFooterType } from "src/types/headerAndFooter.type";
import { IMediaDocument } from "src/types/media.type";

import { headerAndFooterService } from "../services";

export const createHeaderAndFooter = expressAsyncHandler(
  async (req: Request, res: Response) => {
    const doc = await headerAndFooterService.createHeaderAndFooter(req.body);
    res.status(200).send(doc);
  }
);

export const getHeaderAndFooters = expressAsyncHandler(
  async (req: Request, res: Response) => {
    const docs = await headerAndFooterService.getHeaderAndFooters();
    res.status(200).send(docs);
  }
);

export const queryHeaderAndFooters = expressAsyncHandler(
  async (req: Request, res: Response) => {
    const docs = await headerAndFooterService.queryHeaderAndFooters(
      {},
      {
        page: req?.query?.page ? +req.query.page : 1,
        limit: req?.query?.limit ? +req.query.limit : 1,
        sort: { createdAt: -1 },
      }
    );
    res.status(200).send(docs);
  }
);

export const getHeaderAndFooterById = expressAsyncHandler(
  async (req: Request<{ id: string }>, res: Response) => {
    const docs = await headerAndFooterService.getHeaderAndFooterById(
      req.params.id
    );
    res.status(200).send(docs);
  }
);

export const updateHeaderAndFooter = expressAsyncHandler(
  async (
    req: Request<
      { id: string },
      unknown,
      HeaderAndFooterType<IMediaDocument | Types.ObjectId>
    >,
    res: Response
  ) => {
    const docs = await headerAndFooterService.updateHeaderAndFooter(
      req.params.id,
      req.body
    );
    res.status(200).send(docs);
  }
);

export const selectHeaderAndFooter = expressAsyncHandler(
  async (req: Request<{ id: string }>, res: Response) => {
    const docs = await headerAndFooterService.selectHeaderAndFooter(
      req.params.id
    );
    res.status(200).send(docs);
  }
);

export const deleteHeaderAndFooter = expressAsyncHandler(
  async (req: Request<{ id: string }>, res: Response) => {
    const docs = await headerAndFooterService.deleteHeaderAndFooter(
      req.params.id
    );
    res.status(200).send(docs);
  }
);
