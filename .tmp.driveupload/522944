import { Request, Response } from "express";
import expressAsyncHandler from "express-async-handler";
import { DeviceConfigType } from "src/types/device.type";

import { deviceService } from "../services";

export const createDevice = expressAsyncHandler(
  async (req: Request, res: Response) => {
    const device = await deviceService.createDevice(req.body);
    res.status(200).send(device);
  }
);

export const getDevices = expressAsyncHandler(
  async (req: Request, res: Response) => {
    const devices = await deviceService.getDevices();
    res.status(200).send(devices);
  }
);

export const getDeviceById = expressAsyncHandler(
  async (req: Request<{ id: string }>, res: Response) => {
    const device = await deviceService.getDeviceById(req.params.id);
    res.status(200).send(device);
  }
);

export const queryDevices = expressAsyncHandler(
  async (req: Request, res: Response) => {
    const devices = await deviceService.queryDevices(
      {},
      {
        page: req?.query?.page ? +req.query.page : 1,
        limit: req?.query?.limit ? +req.query.limit : 1,
        sort: { createdAt: -1 },
      }
    );
    res.status(200).send(devices);
  }
);

export const updateDeviceConfig = expressAsyncHandler(
  async (
    req: Request<{ id: string }, unknown, DeviceConfigType>,
    res: Response
  ) => {
    const config = await deviceService.updateDeviceConfig(
      req.params.id,
      req.body
    );

    res.status(200).send(config);
  }
);
