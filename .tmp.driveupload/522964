import { HydratedDocument, Types } from "mongoose";

export interface HeaderFooterConfig<T = Types.ObjectId | string | null> {
  textName: string;
  textPosition: string;
  textSize: string;
  textFont: string;
  image: T;
  width: number;
  height: number;
  imagePosition: string;
  companyName: boolean;
  calibrate: boolean;
  reportGenerated: boolean;
  deviceId: boolean;
}

export interface HeaderAndFooterType<T = Types.ObjectId | string | null> {
  name: string;
  header: HeaderFooterConfig<T>;
  footer: Omit<
    HeaderFooterConfig<T>,
    "companyName" | "calibrate" | "reportGenerated" | "deviceId"
  >;
  selected: boolean;
}

export interface IHeaderAndFooterDocument<T = Types.ObjectId | string | null>
  extends HydratedDocument<HeaderAndFooterType<T>> {}
