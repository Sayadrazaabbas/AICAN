import { AlertCircle } from "lucide-react";
import {
  MouseEventHandler,
  useContext,
  useEffect,
  useRef,
  useState,
} from "react";

import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { Button } from "@/components/ui/button";
import { DeviceData, deviceDataContext } from "@/contexts/DeviceDataContext";

interface PropTypes {
  deviceId: string;
  min: number;
  max: number;
}

/* eslint-disable jsx-a11y/media-has-caption */
export default function Alarm({ deviceId, min, max }: PropTypes) {
  const [alarmTriggered, setAlarmTriggered] = useState<string | null>(null);
  const ref = useRef<HTMLAudioElement>(null);

  const { deviceValues } = useContext<DeviceData>(deviceDataContext);

  const value = +(deviceValues?.[`/${deviceId}/PH_VAL`] || 0);
  const isActive = deviceValues?.[`/${deviceId}/STATUS`] === "1";

  useEffect(() => {
    if (min >= max || !isActive) {
      setAlarmTriggered(null);
      if (ref.current) {
        ref.current.pause();
        ref.current.currentTime = 0;
      }
    } else {
      if (value < min) {
        setAlarmTriggered("min");
      } else if (value > max) {
        setAlarmTriggered("max");
      }

      ref.current?.play();
    }
  }, [value, min, max, isActive]);

  const muteAlarm: MouseEventHandler<HTMLButtonElement> = () => {
    if (ref.current) {
      ref.current.pause();
      ref.current.currentTime = 0;
    }
  };

  return (
    <>
      {!!alarmTriggered && (
        <Alert variant="destructive" className="mt-3">
          <AlertCircle className="h-4 w-4" />
          <AlertTitle>Warning alarm triggered</AlertTitle>
          <AlertDescription>
            <div className="flex w-full justify-between">
              PH value is {alarmTriggered === "min" ? "less" : "greater"} than
              the {alarmTriggered === "min" ? "minimum" : "maximum"} set value
              <Button size="sm" variant="destructive" onClick={muteAlarm}>
                Mute Alarm
              </Button>
            </div>
          </AlertDescription>
        </Alert>
      )}

      <audio controls preload="auto" ref={ref} className="hidden">
        <source src="/alarm.mp3" type="audio/mpeg" />
      </audio>
    </>
  );
}
